class SocketListener:
    """Main class for socket communication with auto-reconnect"""

    def __init__(self, client, proxy: str = "", tag: str = "", debug: bool = False):
        self._closed: bool = False
        self._connected: bool = False
        self.client = client
        self.tag = tag
        self.debug = debug

        # Setup proxy
        self.proxy_config = ProxyConfig.from_string(proxy) if proxy else None
        # Connection management (ВКЛЮЧЕН TLS)
        self.connection = SocketConnection(tag, self.proxy_config, use_tls=True)
        self.alive = False
        self.do_commands = True

        # Message handling
        self.message_queue: queue.Queue = queue.Queue()
        self.handlers: Dict[str, List[Callable]] = {}

        # Reconnection management
        self.current_reconnect_attempts = 0
        self.last_newline_time = time.time()

        # Threading
        self._lock = threading.Lock()
        self.logger = logger

        self._shutdown_event = threading.Event()
        self._receiver_thread: Optional[threading.Thread] = None
        self._closed = False
        self.platform = None

    def create_connection(
            self,
            server_id: Optional['Server'] = None,
            ip: Optional[str] = None,
            port: Optional[int] = None,
            platform: Optional[str] = "android",
    ) -> None:
        """Create new connection to server"""
        # Get server info if not provided
        self.platform = platform
        if port is None:
            try:
                ip, port = ServerManager.get_server_info(server_id, platform=self.platform)
                if hasattr(self.client, 'game'):
                    self.client.game.server_id = server_id
            except Exception as e:
                logger.error(f"[{self.tag}] Failed to get server info: {e}")
                self._handle_error(e)
                return
        else:
            try:
                ip, port1 = ServerManager.get_server_info(server_id, platform=self.platform)

                if hasattr(self.client, 'game'):
                    self.client.game.server_id = server_id
            except Exception as e:
                logger.error(f"[{self.tag}] Failed to get server info: {e}")
                self._handle_error(e)
                return
        # Establish connection
        try:
            self.connection.connect(ip, port)
            self.alive = True
            self._shutdown_event.clear()
            self.current_reconnect_attempts = 0

            # Start message receiver thread
            self._receiver_thread = threading.Thread(
                target=self._receive_messages,
                daemon=True,
                name=f"SocketReceiver-{self.tag}"
            )
            self._receiver_thread.start()
        except SocketConnectionError as e:
            logger.error(f"[{self.tag}] Connection failed: {e}")
            self._handle_error(e)

    def send_server_v2(self, data: str):
        try:
            self.connection.send(data.encode())
        except Exception as e:
            logger.error(f"[{self.tag}] Send failed: {e}")
            self._handle_error(e)

    def send_server(self, data: Dict[str, Any]) -> None:
        """Send message to server"""
        try:
            logger.debug(f"[{self.tag}] Sending: {data}")

            data_copy = data.copy()

            command = data_copy.pop('command', '')
            json_data = json.dumps(data_copy, separators=(',', ':'))

            # Remove empty JSON objects
            if json_data == '{}':
                json_data = ''

            message = f"{command}{json_data}\n"

            self.connection.send(message.encode())

        except Exception as e:
            logger.error(f"[{self.tag}] Send failed: {e}")
            self._handle_error(e)

    def send_raw(self, data: str) -> None:
        """Send raw string data"""
        try:
            self.connection.send(data.encode())
        except Exception as e:
            self._handle_error(e)

    def listen(self, timeout: Optional[float] = ConnectionConfig.LISTEN_TIMEOUT) -> Optional[Dict[str, Any]]:
        """Wait for and return next message from queue"""
        try:
            message = self.message_queue.get(timeout=timeout)
            self.current_reconnect_attempts = 0
            return message

        except queue.Empty:
            logger.warning(f"[{self.tag}] Listen timeout, reconnecting...")
            if not self._reconnect():
                self.alive = False
            return None

        except Exception as e:
            logger.error(f"[{self.tag}] Listen error: {e}")
            if not self._reconnect():
                self.alive = False
            return None

    def wait_for_command(self, command: str) -> Optional[Dict[str, Any]]:
        """Wait for specific command, handling errors and alerts"""
        empty_count = 0
        broken_count = 0

        while True:
            if (broken_count > ConnectionConfig.MAX_BROKEN_DATA_ATTEMPTS or
                    empty_count > ConnectionConfig.MAX_EMPTY_MESSAGES):
                logger.error(
                    f"[{self.tag}] Failed to get data: "
                    f"broken={broken_count}, empty={empty_count}"
                )
                return None

            data = self.listen()

            if data is None:
                broken_count += 1
                logger.debug(f"[{self.tag}] Broken data attempt {broken_count}")
                continue

            cmd = data.get('command', '')

            if not cmd:
                empty_count += 1
                logger.debug(f"[{self.tag}] Empty message {empty_count}")
                continue

            if cmd in [command, "err", "error", "alert"]:
                return data

            # Reset counters on valid data
            empty_count = 0
            broken_count = 0

    def event(self, command: str = "all") -> Callable:
        """Decorator to register event handler"""

        def register_handler(handler: Callable) -> Callable:
            if command not in self.handlers:
                self.handlers[command] = []
            self.handlers[command].append(handler)
            return handler

        return register_handler

    def on_error(self, handler: Callable) -> Callable:
        """Register error handler"""
        self.handlers["error"] = [handler]
        return handler

    def _receive_messages(self) -> None:
        """Main message receiving loop (runs in separate thread)"""
        logger.debug(f"[{self.tag}] Message receiver started")
        buffer = b""
        self.last_newline_time = time.time()

        while self.alive and not self._shutdown_event.is_set():
            try:
                # Check for newline timeout
                if time.time() - self.last_newline_time > ConnectionConfig.NEWLINE_TIMEOUT:
                    logger.warning(
                        f"[{self.tag}] No newline for "
                        f"{ConnectionConfig.NEWLINE_TIMEOUT}s, reconnecting..."
                    )
                    if self._reconnect():
                        buffer = b""
                        self.last_newline_time = time.time()
                    continue

                # Receive data
                try:
                    chunk = self.connection.receive()
                except SocketTimeoutError:
                    continue  # Timeout is OK, just check conditions and wait again
                except SocketConnectionError as e:
                    logger.error(f"[{self.tag}] Connection lost/closed: {e}")
                    if self._reconnect():
                        buffer = b""
                    continue

                buffer += chunk

                # Update newline timestamp
                if b'\n' in chunk:
                    self.last_newline_time = time.time()

                # Process complete lines
                lines = buffer.split(b'\n')
                buffer = lines.pop()  # Keep incomplete line in buffer

                for line in lines:
                    self._process_message(line)

            except Exception as e:
                if self._shutdown_event.is_set():
                    break
                logger.error(f"[{self.tag}] Unexpected error in receiver: {e}")
                time.sleep(1) # Защита от 100% CPU при непредвиденных зацикленных ошибках

        logger.debug(f"[{self.tag}] Message receiver stopped")

    def _process_message(self, line: bytes) -> None:
        """Process single message line"""
        try:
            message = MessageParser.parse(line)

            if not message.get('command'):
                self.message_queue.put({'command': ''})
                return

            logger.debug(f"[{self.tag}] Received: {message}")

            # Add to queue
            self.message_queue.put(message)

            # Call handlers
            command = message['command']
            for handler_key in ['all', command]:
                for handler in self.handlers.get(handler_key, []):
                    try:
                        handler(message)
                    except Exception as e:
                        logger.error(f"[{self.tag}] Handler error: {e}")

            # Clear queue on game over
            if command == 'game_over':
                with self.message_queue.mutex:
                    self.message_queue.queue.clear()

        except Exception as e:
            logger.error(f"[{self.tag}] Error processing message: {e}")

    def _reconnect(self) -> bool:
        """Attempt to reconnect to server"""
        with self._lock:
            self.alive = False

            if self.current_reconnect_attempts >= ConnectionConfig.MAX_RECONNECT_ATTEMPTS:
                logger.error(f"[{self.tag}] Max reconnect attempts reached")
                self.do_commands = False
                return False

            # Задержка только для повторных попыток (2-я и 3-я)
            if self.current_reconnect_attempts > 0:
                logger.info(f"[{self.tag}] Waiting {ConnectionConfig.RECONNECT_DELAY}s before retry...")
                time.sleep(ConnectionConfig.RECONNECT_DELAY)

            self.current_reconnect_attempts += 1
            logger.info(
                f"[{self.tag}] Reconnecting "
                f"({self.current_reconnect_attempts}/{ConnectionConfig.MAX_RECONNECT_ATTEMPTS})..."
            )

            # Close old connection
            self.connection.close()

            try:
                # Get server info
                server_id = getattr(self.client.game, 'server_id', None)
                ip, port = ServerManager.get_server_info(server_id, platform=self.client.authorization.platform)

                # Reconnect
                self.connection.connect(ip, port)

                # Re-authenticate
                if hasattr(self.client, 'authorization'):
                    self.client.authorization.get_session_key(self.client.authorization.c_packet)

                self.alive = True
                self.current_reconnect_attempts = 0
                logger.info(f"[{self.tag}] Reconnected successfully")
                return True

            except Exception as e:
                logger.error(f"[{self.tag}] Reconnect failed: {e}")
                self.do_commands = False
                self.alive = False
                return False

    def _handle_error(self, error: Exception) -> None:
        """Handle error by calling registered error handlers"""
        for handler in self.handlers.get("error", []):
            try:
                handler(error)
            except Exception as e:
                logger.error(f"[{self.tag}] Error handler failed: {e}")

    def close(self, timeout: float = 5.0) -> None:
        """
        Gracefully close connection and stop listener.

        Args:
            timeout: Maximum time to wait for threads to finish
        """
        with self._lock:
            if self._closed:
                logger.debug(f"[{self.tag}] Already closed")
                return

            logger.info(f"[{self.tag}] Closing connection...")
            self._closed = True

        # 1. Сигнализируем о завершении
        self._shutdown_event.set()
        self.alive = False
        self.do_commands = False

        # 2. Закрываем сокет (это разблокирует receive())
        try:
            self.connection.close()
        except Exception as e:
            logger.warning(f"[{self.tag}] Error closing connection: {e}")

        # 3. Ждём завершения потока приёма
        if self._receiver_thread and self._receiver_thread.is_alive():
            logger.debug(f"[{self.tag}] Waiting for receiver thread...")
            self._receiver_thread.join(timeout=timeout)

            if self._receiver_thread.is_alive():
                logger.warning(f"[{self.tag}] Receiver thread did not stop in time")

        # 4. Очищаем очередь сообщений
        self._clear_queue()
        self.client.info = {}
        # 5. Очищаем обработчики (опционально)
        # self.handlers.clear()
        logger.info(f"[{self.tag}] Connection closed")

    def _clear_queue(self) -> None:
        """Clear message queue"""
        try:
            while True:
                self.message_queue.get_nowait()
        except queue.Empty:
            pass

    def __enter__(self):
        """Context manager entry"""
        return self

    def __exit__(self, exc_type, exc_val, exc_tb):
        """Context manager exit - ensures cleanup"""
        self.close()
        return False

    def __del__(self):
        """Destructor - last resort cleanup"""
        if not self._closed:
            try:
                self.close(timeout=1.0)
            except Exception:
                pass
