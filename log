class ConnectionConfig:
    DEFAULT_TIMEOUT = 10
    SOCKET_TIMEOUT = 3
    NEWLINE_TIMEOUT = 5
    MAX_RECONNECT_ATTEMPTS = 3
    RECONNECT_DELAY = 3
    BUFFER_SIZE = 4096
