@dataclass
class ProxyConfig:
    """Proxy configuration"""
    host: str
    port: int
    username: Optional[str] = None
    password: Optional[str] = None
    use_ssl: bool = False
    verify_ssl: bool = True

    @classmethod
    def from_string(cls, proxy_str: str) -> 'ProxyConfig':
        """Parse proxy string in format: [scheme://][username:password@]host:port"""
        use_ssl = False
        if proxy_str.startswith("https://"):
            use_ssl = True
            proxy_str = proxy_str[8:]
        elif proxy_str.startswith("http://"):
            use_ssl = False
            proxy_str = proxy_str[7:]

        # Поддержка формата user:pass@host:port
        if "@" in proxy_str:
            auth, host_port = proxy_str.split("@", 1)
            username, password = auth.split(":", 1)
            host, port = host_port.split(":", 1)
            return cls(host=host, port=int(port), username=username, password=password, use_ssl=use_ssl)

        # Поддержка старого формата username:password:host:port
        parts = proxy_str.split(":")
        if len(parts) == 4:
            return cls(host=parts[2], port=int(parts[3]), username=parts[0], password=parts[1], use_ssl=use_ssl)
        elif len(parts) == 2:
            return cls(host=parts[0], port=int(parts[1]), use_ssl=use_ssl)
        else:
            raise ValueError(f"Invalid proxy format: {proxy_str}")

    @property
    def requires_ssl(self) -> bool:
        """Check if SSL is required based on explicit scheme or port"""
        return self.use_ssl or self.port in (443, 8443)


class SocketConnectionError(Exception):
    pass


class SocketTimeoutError(SocketConnectionError):
    pass


class ProxyConnectionError(SocketConnectionError):
    pass


class ServerConnectionError(SocketConnectionError):
    pass


class TLSSocketAdapter:
    """
    Адаптер для реализации 'TLS внутри TLS'.
    Использует MemoryBIO и потокобезопасные блокировки для предотвращения
    повреждения внутреннего состояния OpenSSL при асинхронном чтении/записи.
    """

    def __init__(self, raw_socket: socket.socket, ssl_obj: ssl.SSLObject, in_bio: ssl.MemoryBIO,
                 out_bio: ssl.MemoryBIO):
        self.raw_socket = raw_socket
        self.ssl_obj = ssl_obj
        self.in_bio = in_bio
        self.out_bio = out_bio
        self._bio_lock = threading.Lock()  # ЗАМОК ДЛЯ ПОТОКОБЕЗОПАСНОСТИ

    def settimeout(self, timeout):
        self.raw_socket.settimeout(timeout)

    def _flush_out(self):
        """Отправляет зашифрованные данные из буфера в реальный сокет. (Вызывать под _bio_lock!)"""
        while True:
            data = self.out_bio.read()
            if not data:
                break
            self.raw_socket.sendall(data)

    def send(self, data: bytes) -> int:
        with self._bio_lock:
            while True:
                try:
                    written = self.ssl_obj.write(data)
                    self._flush_out()
                    return written
                except ssl.SSLWantReadError:
                    self._flush_out()
                    break  # Выходим из блокировки, нужно читать сеть (редкий случай для TLS)

        # Если дошли сюда, нужно вычитать сеть без блокировки других потоков
        try:
            raw_data = self.raw_socket.recv(4096)
            if not raw_data:
                raise ssl.SSLError("Connection closed while sending")
            with self._bio_lock:
                self.in_bio.write(raw_data)
        except socket.timeout:
            raise socket.timeout("Send timeout")

        return self.send(data)

    def recv(self, bufsize: int) -> bytes:
        while True:
            with self._bio_lock:
                try:
                    data = self.ssl_obj.read(bufsize)
                    self._flush_out()
                    return data
                except ssl.SSLWantReadError:
                    self._flush_out()
                    # Нет расшифрованных данных, нужно вычитать из сети (выходим из блока with)

            # Читаем из сети БЕЗ блокировки, чтобы send() из главного потока мог работать!
            try:
                raw_data = self.raw_socket.recv(4096)
                if not raw_data:
                    return b""
                with self._bio_lock:
                    self.in_bio.write(raw_data)
            except socket.timeout:
                raise socket.timeout("Receive timeout")

    def close(self):
        try:
            self.raw_socket.close()
        except:
            pass

    def shutdown(self, how):
        try:
            self.raw_socket.shutdown(how)
        except:
            pass

class SocketConnection:
    """Handles low-level socket operations with TLS support"""

    def __init__(self, tag: str, proxy_config: Optional[ProxyConfig] = None, use_tls: bool = True):
        self.tag = tag
        self.proxy_config = proxy_config
        self.use_tls = use_tls
        self.socket = None
        self._lock = threading.Lock()

    def connect(self, host: str, port: int) -> None:
        with self._lock:
            self.close()
            last_error = None

            for attempt in range(1, ConnectionConfig.MAX_CONNECT_ATTEMPTS + 1):
                try:
                    logger.info(f"[{self.tag}] Connection attempt {attempt}/{ConnectionConfig.MAX_CONNECT_ATTEMPTS}")

                    self.socket = self._connect_via_proxy(host, port)

                    self.socket.settimeout(ConnectionConfig.SOCKET_TIMEOUT)

                    self.real_host = host
                    self.real_port = port


                    logger.info(f"[{self.tag}] Connected to {host}:{port}")
                    return

                except Exception as e:
                    last_error = ServerConnectionError(str(e))
                    logger.warning(f"[{self.tag}] Attempt {attempt} failed: {e}")

                if self.socket:
                    try:
                        self.socket.close()
                    except:
                        pass
                    self.socket = None

                if attempt < ConnectionConfig.MAX_CONNECT_ATTEMPTS:
                    time.sleep(ConnectionConfig.CONNECT_RETRY_DELAY)

            raise last_error if last_error else ServerConnectionError("Connection failed")

    def _get_ssl_context(self, verify: bool = True) -> ssl.SSLContext:
        context = ssl.create_default_context()
        if not verify:
            context.check_hostname = False
            context.verify_mode = ssl.CERT_NONE
        return context

    def _connect_direct(self, host: str, port: int) -> socket.socket:
        logger.info(f"[{self.tag}] Direct connection to {host}:{port} (TLS: {self.use_tls})")
        sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        sock.settimeout(ConnectionConfig.DEFAULT_TIMEOUT)
        sock.connect((host, port))

        if self.use_tls:
            context = self._get_ssl_context(verify=False)
            sock = context.wrap_socket(sock, server_hostname=host)
            logger.info(f"[{self.tag}] TLS handshake successful")

        return sock

    def _wrap_tls_in_tls(self, sock: socket.socket, target_host: str) -> TLSSocketAdapter:
        """Специальная обертка для работы TLS внутри уже зашифрованного туннеля HTTPS прокси"""
        context = self._get_ssl_context(verify=False)
        in_bio = ssl.MemoryBIO()
        out_bio = ssl.MemoryBIO()
        ssl_obj = context.wrap_bio(in_bio, out_bio, server_hostname=target_host)

        adapter = TLSSocketAdapter(sock, ssl_obj, in_bio, out_bio)

        # Рукопожатие (Handshake) с потокобезопасностью
        while True:
            with adapter._bio_lock:
                try:
                    ssl_obj.do_handshake()
                    adapter._flush_out()
                    break
                except ssl.SSLWantReadError:
                    adapter._flush_out()

            # Читаем из сети без лока
            try:
                raw_data = sock.recv(4096)
                if not raw_data:
                    raise ssl.SSLError("Connection closed by proxy during inner TLS handshake")
                with adapter._bio_lock:
                    in_bio.write(raw_data)
            except socket.timeout:
                raise socket.timeout("Inner TLS handshake timeout")

        return adapter


    def _connect_via_proxy(self, target_host: str, target_port: int) -> socket.socket:
        logger.info(f"[{self.tag}] Connecting via proxy {self.proxy_config.host}:{self.proxy_config.port}")

        sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        sock.settimeout(ConnectionConfig.DEFAULT_TIMEOUT)

        # 1. Подключение к прокси
        if self.proxy_config.requires_ssl:
            proxy_context = self._get_ssl_context(verify=self.proxy_config.verify_ssl)
            sock.connect((self.proxy_config.host, self.proxy_config.port))
            sock = proxy_context.wrap_socket(sock, server_hostname=self.proxy_config.host)
        else:
            sock.connect((self.proxy_config.host, self.proxy_config.port))

        # 2. Туннель
        self._send_connect_request(sock, target_host, target_port)
        self._verify_connect_response(sock)
        logger.info(f"[{self.tag}] Proxy tunnel established to {target_host}:{target_port}")

        # 3. Защита соединения с ИГРОВЫМ СЕРВЕРОМ
        if self.use_tls:
            logger.info(f"[{self.tag}] Starting TLS handshake with target server over proxy tunnel...")
            try:
                if self.proxy_config.requires_ssl:
                    # Используем безопасный адаптер, чтобы обойти баг извлечения fileno в Python!
                    sock = self._wrap_tls_in_tls(sock, target_host)
                else:
                    # Обычная обертка если сам прокси не зашифрован
                    target_context = self._get_ssl_context(verify=False)
                    sock = target_context.wrap_socket(sock, server_hostname=target_host)

                logger.info(f"[{self.tag}] Target TLS handshake successful")
            except Exception as e:
                raise ProxyConnectionError(
                    f"TLS handshake with target failed (Proxy might block port {target_port}): {e}")

        return sock

    def _send_connect_request(self, sock: socket.socket, host: str, port: int) -> None:
        """Отправка HTTP/1.1 CONNECT. HTTP/1.1 безопаснее, так как поддерживает Keep-Alive"""
        request_lines = [
            f"CONNECT {host}:{port} HTTP/1.1",
            f"Host: {host}:{port}",
            "Proxy-Connection: keep-alive",
            "Connection: keep-alive",
            "User-Agent: Mozilla/5.0"
        ]

        if self.proxy_config.username and self.proxy_config.password:
            credentials = f"{self.proxy_config.username}:{self.proxy_config.password}"
            encoded = base64.b64encode(credentials.encode()).decode()
            request_lines.append(f"Proxy-Authorization: Basic {encoded}")

        # Надежно закрываем заголовки двойным переносом строки
        request = "\r\n".join(request_lines) + "\r\n\r\n"

        sock.sendall(request.encode())

    def _verify_connect_response(self, sock: socket.socket) -> None:
        response = b""
        while b"\r\n\r\n" not in response:
            try:
                chunk = sock.recv(1)
                if not chunk:
                    raise ProxyConnectionError("Proxy closed connection during CONNECT phase")
                response += chunk
            except socket.timeout:
                raise ProxyConnectionError("Timeout while waiting for proxy CONNECT response")

        headers_str = response.decode('utf-8', errors='ignore')
        status_line = headers_str.split('\r\n')[0]

        logger.debug(f"[{self.tag}] Proxy response: {status_line}")

        if " 200 " not in status_line:
            raise ProxyConnectionError(f"Proxy returned error: {status_line}")
        logger.debug(f"[{self.tag}] Proxy tunnel established cleanly")

    def send(self, data: bytes) -> None:
        if not self.socket:
            raise SocketConnectionError("Socket not connected")
        try:
            self.socket.send(data)
        except socket.error as e:
            raise SocketConnectionError(f"Send failed: {e}")

    def receive(self, buffer_size: int = ConnectionConfig.BUFFER_SIZE) -> bytes:
        if not self.socket:
            raise SocketConnectionError("Socket not connected")
        try:
            chunk = self.socket.recv(buffer_size)
            if not chunk:
                raise SocketConnectionError("Connection closed by peer")
            return chunk
        except socket.timeout:
            raise SocketTimeoutError("Receive timeout")
        except socket.error as e:
            raise SocketConnectionError(f"Receive failed: {e}")

    def close(self) -> None:
        if self.socket:
            try:
                self.socket.shutdown(socket.SHUT_RDWR)
            except Exception:
                pass
            finally:
                try:
                    self.socket.close()
                except Exception:
                    pass
                self.socket = None

    def is_connected(self) -> bool:
        return self.socket is not None


class MessageParser:
    """Parses incoming messages"""

    @staticmethod
    def parse(line: bytes) -> Dict[str, Any]:
        """Parse message line into dictionary"""
        try:
            message_str = line.decode('utf-8').strip()
            if not message_str:
                return {'command': ''}

            # Find JSON part
            json_start = message_str.find('{')

            if json_start != -1:
                command = message_str[:json_start].strip()
                json_str = message_str[json_start:]

                try:
                    message = json.loads(json_str)
                    # Normalize boolean values
                    if 'new' in message and isinstance(message['new'], str):
                        message['new'] = message['new'].lower() == 'true'
                except json.JSONDecodeError:
                    logger.warning(f"Invalid JSON: {json_str}")
                    message = {}
                    command = message_str
            else:
                message = {}
                command = message_str

            message['command'] = command
            return message

        except Exception as e:
            logger.error(f"Error parsing message: {e}")
            return {'command': 'error', 'error': str(e)}


class ServerManager:
    API_URL = "https://static.rstgames.ru/durak/"
    TIMEOUT = (5, 10)

    @classmethod
    def _get_session(cls) -> requests.Session:
        """Создаёт сессию с retry-политикой"""
        session = requests.Session()
        retry = Retry(
            total=3,
            backoff_factor=0.5,
            status_forcelist=[500, 502, 503, 504],
            raise_on_status=False,
            connect=3,           # Retry при ошибках соединения
            read=3,              # Retry при ошибках чтения (Read timed out)
            allowed_methods=["GET", "POST"],  # Для каких методов разрешён retry
        )
        adapter = HTTPAdapter(max_retries=retry)
        session.mount("https://", adapter)
        session.mount("http://", adapter)
        return session

    @classmethod
    def get_servers(cls) -> Dict[str, Any]:
        # return config_servers
        """Fetch server list from API with retry"""
        try:
            session = cls._get_session()
            response = session.get(
                f"{cls.API_URL}servers.json",
                timeout=cls.TIMEOUT
            )
            response.raise_for_status()
            return response.json()
        except requests.Timeout:
            raise ServerConnectionError("Request timed out after all retries")
        except requests.RequestException as e:
            raise ServerConnectionError(f"Failed to fetch servers: {e}")

    @classmethod
    def get_server_info(cls, server_id: Optional['Server'] = None, platform = "android") -> tuple[str, int]:
        """Get IP and port for specified server"""
        servers = cls.get_servers()["user"]

        if server_id is not None:
            server = servers.get(server_id)
            if not server:
                raise ValueError(f"Server {server_id} not found")
        else:
            server = random.choice(list(servers.values()))

        return server["host"], server[f"tls_{platform}"]

