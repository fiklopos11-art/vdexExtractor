setTimeout(function () {
    console.log("\n[+] Активация точечного инспектора нативных команд...");

    Java.perform(function () {
        try {
            const LibApplication = Java.use("com.google.android.play.core.common.LibApplication");
            
            // Карта верифицированных опкодов протектора
            const OP_MAP = {
                675:  "Кастомный крипто-опкод (Генерация/Выдача итогового хэша)",
                2213: "Команда подписи пакета (sign)",
                75:   "StringBuilder.toString (Сборка текстового контента)",
                202:  "JSONObject.optString (Чтение параметров из JSON)",
                2531: "s4.d.nextValue (Парсинг токена виртуальной машины)",
                5326: "JSONTokener.nextString (Чтение строкового литерала JSON)"
            };

            // Функция безопасной инспекции аргументов на входе в опкод
            function safeInspectArgs(opId, args) {
                console.log(`\n📥 [ВХОД В ОПКОД] ID: ${opId} -> ${OP_MAP[opId] || "Кастомная операция"}`);
                
                // Начинаем с индекса 1, так как индекс 0 — это сам opId (int)
                for (let i = 1; i < args.length; i++) {
                    let arg = args[i];
                    if (arg === null || arg === undefined) {
                        console.log(`  -> Аргумент [${i}]: null`);
                        continue;
                    }

                    try {
                        // Если аргумент является примитивным типом JavaScript (число, булево)
                        if (typeof arg !== "object") {
                            console.log(`  -> Аргумент [${i}] (Примитив): ${arg}`);
                            continue;
                        }

                        // Исследуем экземпляр Java-объекта
                        let className = arg.getClass().getName();
                        let shortClassName = className.toString().split('.').pop();
                        
                        if (className === "java.lang.String") {
                            console.log(`  -> Аргумент [${i}] (String): "${arg.toString()}"`);
                        } else if (className === "java.lang.Integer" || className === "java.lang.Long" || className === "java.lang.Boolean") {
                            console.log(`  -> Аргумент [${i}] (${shortClassName}): ${arg.toString()}`);
                        } else if (className === "[B") {
                            // Безопасная обработка сырых массивов байт (byte[]) через внутренний API Frida
                            let bytes = Java.arrayToBytes(arg);
                            let hexResult = "";
                            let asciiResult = "";
                            
                            for (let j = 0; j < bytes.length; j++) {
                                let unsignedByte = bytes[j] & 0xFF;
                                hexResult += unsignedByte.toString(16).padStart(2, '0') + " ";
                                asciiResult += (unsignedByte >= 32 && unsignedByte <= 126) ? String.fromCharCode(unsignedByte) : ".";
                            }
                            console.log(`  -> Аргумент [${i}] (byte[]): HEX[ ${hexResult.trim()} ] | ASCII[ ${asciiResult} ]`);
                        } else {
                            // Для комплексных или обфусцированных классов выводим их тип и безопасно сканируем строковые поля
                            console.log(`  -> Аргумент [${i}] (Объект класса): ${className}`);
                            try {
                                let fields = arg.getClass().getDeclaredFields();
                                fields.forEach(function (field) {
                                    field.setAccessible(true);
                                    let fieldName = field.getName();
                                    let fieldType = field.getType().getName();
                                    let fieldVal = field.get(arg);
                                    
                                    if (fieldVal !== null && fieldVal !== undefined) {
                                        // Выводим только String-поля во избежание рекурсивного вызова toString у очередей и локов
                                        if (fieldType === "java.lang.String") {
                                            console.log(`       └─ Поле "${fieldName}" (String): "${fieldVal.toString()}"`);
                                        }
                                    }
                                });
                            } catch (fieldErr) {}
                        }
                    } catch (argErr) {
                        console.log(`  -> Аргумент [${i}]: [Не удалось десериализовать: ${argErr.message}]`);
                    }
                }
            }

            // Перехватываем центральный диспетчер
            LibApplication.i.overloads.forEach(function (overload) {
                overload.implementation = function () {
                    const opId = arguments[0];
                    let isTargetOp = false;

                    if (opId !== null && opId !== undefined && typeof opId === "number") {
                        if (OP_MAP.hasOwnProperty(opId)) {
                            isTargetOp = true;
                            try {
                                // Запускаем безопасный разбор параметров на входе
                                safeInspectArgs(opId, arguments);
                            } catch (e) {
                                console.log(`[-] Сбой парсинга на входе опкода ${opId}: ` + e.message);
                            }
                        }
                    }

                    // Выполняем оригинальную операцию нативного ядра протектора
                    const retval = overload.apply(this, arguments);

                    // Фиксируем результат на выходе
                    if (isTargetOp && retval !== null && retval !== undefined) {
                        try {
                            if (retval.getClass().getName() === "java.lang.String") {
                                const finalString = retval.toString();
                                console.log(`📤 [ВЫХОД ИЗ ОПКОДА] ID: ${opId} вернул: "${finalString}"`);
                                console.log(`-----------------------------------------------------`);
                            }
                        } catch (e) {}
                    }

                    return retval;
                };
            });

            console.log("[+] Инспектор успешно интегрирован. Ожидайте генерации сетевого события...");
        } catch (err) {
            console.log("[-] Критическая ошибка развертывания инспектора: " + err.message);
        }
    });
}, 5000);
